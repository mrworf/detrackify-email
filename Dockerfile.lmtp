FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install Python dependencies (excluding development and guard-only tools)
RUN echo "pytest!=*" > constraints.txt && \
    echo "pylint!=*" >> constraints.txt && \
    echo "Flask!=*" >> constraints.txt && \
    echo "gunicorn!=*" >> constraints.txt && \
    echo "rjsmin!=*" >> constraints.txt && \
    pip install --no-cache-dir -r requirements.txt --constraint constraints.txt && \
    rm constraints.txt

COPY detrackify_lmtp.py .
COPY detrackify_email/ ./detrackify_email/
COPY common/ ./common/
COPY extras/docker-entrypoint-lmtp.sh .

RUN useradd --create-home --shell /bin/bash detrackify && \
    chown -R detrackify:detrackify /app

RUN chmod +x docker-entrypoint-lmtp.sh

USER detrackify

EXPOSE 10024

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.settimeout(3); s.connect(('127.0.0.1', 10024)); s.close()" || exit 1

ENTRYPOINT ["./docker-entrypoint-lmtp.sh"]
